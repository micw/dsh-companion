    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "link:../../../../deepseek-harness/vendor/schemastery",
    "@dsh-companion/model-policy": "workspace:*",
    "@dsh-companion/provider-account": "workspace:*",
    "@dsh-companion/provider-catalog": "workspace:*",
    "eventsource-parser": "^3.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/cordis-plugin-loader": "link:../../../../deepseek-harness/vendor/loader",
