{
  "name": "@dsh-companion/bundle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "presets/**/*.yml",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dsh-companion/model-policy": "workspace:*",
    "@dsh-companion/provider-account": "workspace:*",
    "@dsh-companion/provider-catalog": "workspace:*",
    "@dsh-companion/provider-client": "workspace:*",
    "@dsh-companion/session-title": "workspace:*",
    "@dsh-companion/tool-session-title": "workspace:*",
    "@dsh-companion/ui-provider-settings": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/dsh-companion.patch.yml"
      ]
    }
  }
}
