{
  "name": "dsh-companion-vscode",
  "displayName": "DSH Companion",
  "description": "An independent VS Code companion built on DeepSeek Harness.",
  "version": "0.0.0",
  "license": "MIT",
  "publisher": "dsh-companion",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "deepseek",
    "deepseek harness",
    "dsh",
    "coding agent",
    "ai"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/**",
    "media/**",
    "runtime/payload/linux-x64/**",
    "README.md",
    "features.md",
    "LICENSE"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:dshCompanion.newChatEditor",
    "onCommand:dshCompanion.openDevelopmentWebUi",
    "onCommand:dshCompanion.openProviderSettings",
    "onCommand:dshCompanion.searchSessions",
    "onCommand:dshCompanion.stopManagedRuntime",
    "onView:dshCompanion.sessions",
    "onWebviewPanel:dshCompanion.chatEditor"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dshCompanion.newChatEditor",
        "title": "DSH: New Chat Editor",
        "icon": "$(add)"
      },
      {
        "command": "dshCompanion.openSession",
        "title": "DSH: Open Session"
      },
      {
        "command": "dshCompanion.refreshSessions",
        "title": "DSH: Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "dshCompanion.searchSessions",
        "title": "DSH: Search Sessions",
        "icon": "$(search)"
      },
      {
        "command": "dshCompanion.openProviderSettings",
        "title": "DSH: Providers & Models",
        "icon": "$(settings-gear)"
      },
      {
        "command": "dshCompanion.openDevelopmentWebUi",
        "title": "DSH: Open Web UI"
      },
      {
        "command": "dshCompanion.stopManagedRuntime",
        "title": "DSH: Stop Managed Runtime"
      },
      {
        "command": "dshCompanion.openWebviewLink",
        "title": "Open Link"
      },
      {
        "command": "dshCompanion.openWebviewLinkBeside",
        "title": "Open File to the Side"
      },
      {
        "command": "dshCompanion.copyWebviewLink",
        "title": "Copy Link"
      },
      {
        "command": "dshCompanion.copyWebviewAbsolutePath",
        "title": "Copy Absolute Path"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dshCompanion",
          "title": "DSH Companion",
          "icon": "media/dsh-companion.svg"
        }
      ]
    },
    "views": {
      "dshCompanion": [
        {
          "id": "dshCompanion.sessions",
          "name": "Sessions",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "dshCompanion.newChatEditor",
          "when": "view == dshCompanion.sessions",
          "group": "navigation@1"
        },
        {
          "command": "dshCompanion.refreshSessions",
          "when": "view == dshCompanion.sessions",
          "group": "navigation@2"
        },
        {
          "command": "dshCompanion.openProviderSettings",
          "when": "view == dshCompanion.sessions",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "dshCompanion.openSession",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "dshCompanion.openWebviewLink",
          "when": "webviewId == 'dshCompanion.chatEditor' && webviewSection == 'dshCompanionLink'",
          "group": "navigation@1"
        },
        {
          "command": "dshCompanion.openWebviewLinkBeside",
          "when": "webviewId == 'dshCompanion.chatEditor' && webviewSection == 'dshCompanionLink' && dshCompanionLinkKind == 'file'",
          "group": "navigation@2"
        },
        {
          "command": "dshCompanion.copyWebviewLink",
          "when": "webviewId == 'dshCompanion.chatEditor' && webviewSection == 'dshCompanionLink'",
          "group": "clipboard@1"
        },
        {
          "command": "dshCompanion.copyWebviewAbsolutePath",
          "when": "webviewId == 'dshCompanion.chatEditor' && webviewSection == 'dshCompanionLink' && dshCompanionLinkKind == 'file'",
          "group": "clipboard@2"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node ../scripts/bundle-mermaid.mjs",
    "watch": "tsc --watch -p ./"
  },
  "dependencies": {
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@dsh-companion/provider-client": "workspace:*",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.10",
    "mermaid": "^11.17.2",
    "typescript": "^5.4.0"
  }
}
