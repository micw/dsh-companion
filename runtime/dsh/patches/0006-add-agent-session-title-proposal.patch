new file mode 100644
index 0000000000..acde085e5e
--- /dev/null
+++ b/packages/session/session-title/tests/agent-proposal.spec.ts
@@ -0,0 +1,83 @@
+import { Context } from '@deepseek-ai/cordis'
+import { describe, expect, it, vi } from 'vitest'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import SessionStore, { Session, SessionId } from '@deepseek-ai/dsh-session'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import SessionTitleService, { SessionTitleInvalidError, SessionTitleProviderId } from '@deepseek-ai/dsh-session-title'
+import type { SessionTitleProviderRequest } from '@deepseek-ai/dsh-session-title'
+
+const CONFIG = { fallbackMaxWords: 5, fallbackMaxBytes: 40, maxTitleBytes: 40 }
+const TOOL_ID = SessionTitleProviderId('dsh-companion/agent-title-tool')
+
+async function setup(id: string) {
+  const ctx = new Context()
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SessionProjectionRegistry)
+  await ctx.plugin(SessionTitleService, CONFIG)
+  const session = ctx.sessions.create(SessionId(id))
+  return { ctx, session }
+}
+
+function human(session: Session, text: string) {
+  return session.append('user/message', createUserMessage({
+    content: [{ type: 'text', text }], source: { kind: 'user' },
+  }), { surfaceOp: 'append' })
+}
+
+describe('main agent title proposals', () => {
+  it('normalizes and records human citations and the logged main route distinctly from auxiliary providers', async () => {
+    const { ctx, session } = await setup('agent-proposal-source')
+    session.append('turn/start', { turn: 1 })
+    const first = human(session, 'First human message')
+    const latest = human(session, 'Latest human message')
+    session.append('request/header', {
+      header: { config: { provider: 'main-route', model: 'main-model' } }, reason: 'change',
+    })
+    const snapshot = ctx.sessionTitle.proposeFromAgent(session, '  Agent\t title  ', TOOL_ID)
+    expect(snapshot).toMatchObject({
+      title: 'Agent title', messageSeqs: [first.seq, latest.seq],
+      source: { kind: 'provider', provider: TOOL_ID, model: { provider: 'main-route', model: 'main-model' } },
+    })
+    expect(session.snapshotEvents().findLast(event => event.type === 'session/title')?.data)
+      .toMatchObject({ source: { kind: 'provider', provider: TOOL_ID }, messageSeqs: [first.seq, latest.seq] })
+    expect(ctx.sessionTitle.get(session)).toEqual(snapshot)
+  })
+
+  it('preserves manual pin and rejects cancelled, empty, or detached proposals', async () => {
+    const { ctx, session } = await setup('agent-proposal-pin')
+    expect(ctx.sessionTitle.proposeFromAgent(session, 'No human input', TOOL_ID)).toBeUndefined()
+    human(session, 'Human prompt')
+    expect(() => ctx.sessionTitle.proposeFromAgent(session, '\u001b[31m  ', TOOL_ID))
+      .toThrow(SessionTitleInvalidError)
+    const cancelled = new AbortController()
+    cancelled.abort()
+    expect(() => ctx.sessionTitle.proposeFromAgent(session, 'Cancelled', TOOL_ID, cancelled.signal)).toThrow()
+    ctx.sessionTitle.rename(session, 'Manual title')
+    expect(ctx.sessionTitle.proposeFromAgent(session, 'Agent must not replace', TOOL_ID)).toBeUndefined()
+    expect(ctx.sessionTitle.get(session)?.title).toBe('Manual title')
+    expect(() => ctx.sessionTitle.proposeFromAgent(Session.create(SessionId('detached-agent')), 'No', TOOL_ID))
+      .toThrow(/not live/)
+  })
+
+  it('supersedes pending provider completion so a late result cannot overwrite the agent title', async () => {
+    const { ctx, session } = await setup('agent-proposal-stale')
+    let release: (() => void) | undefined
+    const gate = new Promise<void>((resolve) => { release = resolve })
+    const generate = vi.fn(async (request: SessionTitleProviderRequest) => {
+      await gate
+      return { title: 'Late provider', messageSeqs: request.messages.map(message => message.seq) }
+    })
+    ctx.sessionTitle.register({ id: SessionTitleProviderId('slow'), automatic: 'all-prompts', generate })
+    session.append('turn/start', { turn: 1 })
+    human(session, 'Prompt')
+    session.append('request/header', {
+      header: { config: { provider: 'main', model: 'model' } }, reason: 'change',
+    })
+    await new Promise(resolve => setTimeout(resolve, 0))
+    expect(generate).toHaveBeenCalledOnce()
+    ctx.sessionTitle.proposeFromAgent(session, 'Agent wins', TOOL_ID)
+    release?.()
+    await new Promise(resolve => setTimeout(resolve, 0))
+    expect(ctx.sessionTitle.get(session)?.title).toBe('Agent wins')
+  })
+})
