@@ -420,6 +420,54 @@ export class SessionTitleService extends Service {
     return snapshot
   }
 
+  /**
+   * Accept a title proposed by the session's main model agent without another model call.
+   * Only committed human text messages are cited; a manual user title remains pinned.
+   * @param session - exact live session whose agent proposed the title.
+   * @param title - untrusted proposed text, normalized to the configured byte limit.
+   * @param providerId - stable trusted plugin identity distinguishing this agent tool from auxiliary title providers.
+   * @param signal - optional cancellation checked at the commit point.
+   * @returns accepted snapshot, or undefined when pinned or without eligible human input.
+   * @throws {SessionTitleInvalidError} when proposed text normalizes to empty.
+   */
+  proposeFromAgent(
+    session: Session,
+    title: string,
+    providerId: SessionTitleProviderId,
+    signal?: AbortSignal,
+  ): SessionTitleSnapshot | undefined {
+    if (typeof providerId !== 'string' || providerId.length === 0) {
+      throw new Error('session-title agent proposal requires a non-empty trusted provider id')
+    }
+    signal?.throwIfAborted()
+    this.assertServiceActive()
+    if (this.ctx.sessions.get(session.id) !== session) {
+      throw new Error(`session "${session.id}" is not live in this store`)
+    }
+    if (this.get(session)?.source.kind === 'user') return undefined
+    const normalized = normalizeSessionTitle(title, this.config.maxTitleBytes)
+    if (normalized.length === 0) {
+      throw new SessionTitleInvalidError('session title must contain visible characters')
+    }
+    // oxlint-disable-next-line typescript/no-deprecated -- Existing Session history read; migration deferred.
+    const messages = collectSessionTitleMessages(session.snapshotEvents())
+    if (messages.length === 0) return undefined
+    const state = this.stateFor(session)
+    signal?.throwIfAborted()
+    this.supersede(state, 'agent title superseded automatic title generation')
+    const config = session.requestHeader()?.config
+    session.append('session/title', {
+      title: normalized,
+      messageSeqs: messages.map(message => message.seq),
+      source: {
+        kind: 'provider',
+        provider: providerId,
+        ...(config === undefined ? {} : { model: { provider: config.provider, model: config.model } }),
+      },
+    })
+    return this.get(session)
+  }
+
