+/**
+ * React-free DSH Web Client runtime for non-browser product shells. It composes
+ * the generated Remote graph and canonical Session object layer over an
+ * authenticated HTTP/WebSocket carrier without loading the Web UI.
+ *
+ * @module @deepseek-ai/dsh-api-client-runtime
+ */
+import { Context } from '@deepseek-ai/cordis'
+import WebSocket from 'ws'
+import {
+  apply as applyConnection,
+  inject as connectionInject,
+  type ClientTransportHooks,
+  type ConnectionHandle,
+} from '@deepseek-ai/dsh-client-connection/client'
+import {
+  apply as applyTypert,
+  inject as typertInject,
+} from '@deepseek-ai/dsh-typert-registry/client'
+import {
+  apply as applyGateway,
+  inject as gatewayInject,
+  REMOTE_STREAM_MUX_PATH,
+  RemoteStreamMuxClient,
+} from '@deepseek-ai/dsh-api-gateway/client'
+import {
+  apply as applyRemotes,
+  inject as remotesInject,
+  type ClientRemote,
+} from '@deepseek-ai/dsh-api-remotes/client'
+import {
+  apply as applySessions,
+  inject as sessionsInject,
+  type ISessions,
+} from '@deepseek-ai/dsh-api-session-controller/client'
+import type { FileUploadService } from '@deepseek-ai/dsh-client-file-upload/client'
+
+export type {
+  BeginSubmissionInput,
+  ISession,
+  ISessions,
+  PendingSubmission,
+  QueuedMessage,
+  SessionBinding,
+  SessionEventChange,
+  SessionEventLike,
+  SessionEventLikeEntry,
+  SessionEventSource,
+  SessionEventWindow,
+  SessionFace,
+  SessionListState,
+  SessionSnapshot,
+} from '@deepseek-ai/dsh-api-session-controller/client'
+export type { ClientRemote } from '@deepseek-ai/dsh-api-remotes/client'
+export type { ConnectionHandle, ConnectionState } from '@deepseek-ai/dsh-client-connection/client'
+
+/** Inputs for one authenticated DSH Web Client object graph. */
+export interface DshWebClientOptions {
+  /** Exact loopback HTTP origin of the DSH Web Host. */
+  readonly origin: string
+  /** Authority-bound cookie obtained through the DSH launch-token exchange. */
+  readonly cookie: string
+  /** Optional cancellation while the first Connection generation becomes ready. */
+  readonly signal?: AbortSignal
+}
+
+/**
+ * One independently disposable, React-free Client graph. Session, queue,
+ * paging, projection, and reconnect behavior comes from DSH's canonical Client
+ * objects; product shells project their observable values into their own UI.
+ */
+export class DshWebClient {
+  private disposed = false
+
+  private constructor(
+    private readonly ctx: Context,
+    private readonly streamMux: RemoteStreamMuxClient,
+    /** Canonical Session list and Session object owner. */
+    readonly sessions: ISessions,
+    /** Generated Remote namespaces for capabilities outside SessionFace. */
+    readonly remote: ClientRemote,
+    /** Physical Connection generation and recovery state. */
+    readonly connection: ConnectionHandle,
+    /** File-upload service; unavailable until this runtime gains a Node body carrier. */
+    readonly fileUpload: FileUploadService,
+  ) {}
+
+  /**
+   * Connect to one authenticated DSH Web Host and assemble its Client object graph.
+   * @param options - Host authority, browser-session cookie, and optional cancellation.
+   * @returns a ready Client whose first Session-list baseline has settled.
+   */
+  static async connect(options: DshWebClientOptions): Promise<DshWebClient> {
+    const origin = requireLoopbackOrigin(options.origin)
+    if (options.cookie.length === 0 || /[\r\n]/u.test(options.cookie)) {
+      throw new Error('DSH Web Client requires a non-empty single-line cookie')
+    }
+    options.signal?.throwIfAborted()
+    const clientGlobal = globalThis as typeof globalThis & { __DSH_TRANSPORT__?: ClientTransportHooks }
+    if (clientGlobal.__DSH_TRANSPORT__ !== undefined) {
+      throw new Error('A DSH Client transport is already being assembled in this process')
+    }
+
+    const streamUrl = new URL(REMOTE_STREAM_MUX_PATH, origin)
+    streamUrl.protocol = 'ws:'
+    const streamMux = new RemoteStreamMuxClient({
+      url: streamUrl.href,
+      createSocket: url => new WebSocket(url, {
+        headers: { cookie: options.cookie },
+        origin,
+      }) as unknown as globalThis.WebSocket,
+    })
+    const transport: ClientTransportHooks = {
+      ownsHost: true,
+      fetch: async (input, init) => {
+        const target = new URL(`${input.pathname}${input.search}`, origin)
+        const headers = new Headers(init.headers)
+        headers.set('cookie', options.cookie)
+        headers.set('origin', origin)
+        return fetch(target, { ...init, headers })
+      },
+      openStream: (endpoint, payload, signal) => {
+        streamMux.start()
+        return streamMux.open(endpoint, payload, signal)
+      },
+    }
+
+    const ctx = new Context()
+    try {
+      clientGlobal.__DSH_TRANSPORT__ = transport
+      await mount(ctx, typertInject, applyTypert)
+      await mount(ctx, connectionInject, applyConnection)
+      delete clientGlobal.__DSH_TRANSPORT__
+      await mount(ctx, gatewayInject, applyGateway)
+      await mount(ctx, remotesInject, applyRemotes)
+      const unavailableUpload: FileUploadService = {
+        available: false,
+        upload: () => Promise.reject(new Error('File upload is not available in this Client runtime')),
+      }
+      await mount(ctx, [], (uploadCtx) => { uploadCtx.provide('fileUpload', unavailableUpload) })
+      await mount(ctx, sessionsInject, applySessions)
+      const connection = ctx.get('connection') as ConnectionHandle
+      await waitForGeneration(connection, options.signal)
+      const sessions = ctx.get('sessions') as ISessions
+      await sessions.refresh()
+      return new DshWebClient(
+        ctx,
+        streamMux,
+        sessions,
+        ctx.get('remote') as ClientRemote,
+        connection,
+        unavailableUpload,
+      )
+    } catch (error) {
+      delete clientGlobal.__DSH_TRANSPORT__
+      await Promise.allSettled([ctx.fiber.dispose(), streamMux.close()])
+      throw error
+    }
+  }
+
+  /** Release every Session stream, Remote generation, and physical carrier. */
+  async dispose(): Promise<void> {
+    if (this.disposed) return
+    this.disposed = true
+    await this.ctx.fiber.dispose()
+    await this.streamMux.close()
+  }
+}
+
+async function mount(
+  ctx: Context,
+  inject: readonly string[],
+  apply: (ctx: Context) => unknown,
+): Promise<void> {
+  const fiber = ctx.plugin({ inject: [...inject], apply })
+  await fiber.await()
+}
+
+function requireLoopbackOrigin(value: string): string {
+  const url = new URL(value)
+  if (url.protocol !== 'http:' || url.hostname !== '127.0.0.1' || url.pathname !== '/'
+    || url.search !== '' || url.hash !== '') {
+    throw new Error('DSH Web Client origin must be an HTTP IPv4 loopback origin')
+  }
+  return url.origin
+}
+
+function waitForGeneration(connection: ConnectionHandle, signal?: AbortSignal): Promise<void> {
+  signal?.throwIfAborted()
+  return new Promise((resolve, reject) => {
+    const connected = (): void => {
+      if (connection.generation.getSnapshot() === undefined) return
+      cleanup()
+      resolve()
+    }
+    const dispose = connection.generation.subscribe(connected)
+    const aborted = (): void => {
+      cleanup()
+      reject(signal?.reason instanceof Error
+        ? signal.reason
+        : new Error('DSH Client connection aborted', { cause: signal?.reason }))
+    }
+    const cleanup = (): void => {
+      dispose()
+      signal?.removeEventListener('abort', aborted)
+    }
+    signal?.addEventListener('abort', aborted, { once: true })
+    connected()
+  })
+}
