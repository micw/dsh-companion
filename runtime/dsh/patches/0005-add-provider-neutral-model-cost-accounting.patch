+
+import { z } from 'zod'
+import { validateModelCallAccounting, type ModelCallAccounting, type ModelCostKind } from '@deepseek-ai/dsh-llm'
+import type { ProjectionDefinition } from '@deepseek-ai/dsh-session-projection'
+import type { ModelCostProjection } from './projection.ts'
+import {
+  advanceModelCostTurn,
+  type ModelCostBucket,
+  type ModelCostTotal,
+  type ModelCostTurnFold,
+  type TurnModelCost,
+} from './turn-cost.ts'
+
+interface ModelCostState {
+  readonly totals: readonly ModelCostTotal[]
+  readonly breakdown: readonly ModelCostBucket[]
+  readonly coverage: { readonly accountedTurns: number; readonly unaccountedTurns: number }
+  readonly fold: ModelCostTurnFold | null
+}
+
+const kindSchema = z.enum(['reported', 'estimated', 'virtual'])
+const safeNanosSchema = z.number().int().nonnegative().max(Number.MAX_SAFE_INTEGER)
+  .refine(value => !Object.is(value, -0))
+const accountingSchema = z.custom<ModelCallAccounting>((value) => {
+  try {
+    validateModelCallAccounting(value)
+    return true
+  } catch {
+    return false
+  }
+})
+const routeSchema = z.object({ provider: z.string().min(1), model: z.string().min(1) }).strict()
+const callSchema = z.object({ accounting: accountingSchema, route: routeSchema.optional() }).strict()
+const foldSchema: z.ZodType<ModelCostTurnFold> = z.object({
+  turn: z.number().int().nonnegative(),
+  phase: z.enum(['idle', 'open', 'finishClosed', 'settled']),
+  step: z.number().int().nonnegative().optional(),
+  settledBy: z.enum(['message', 'retry']).optional(),
+  route: routeSchema.optional(),
+  calls: z.array(callSchema),
+  hadSettlement: z.boolean(),
+  invalid: z.boolean(),
+}).strict() as unknown as z.ZodType<ModelCostTurnFold>
+const totalSchema = z.object({
+  currency: z.string().regex(/^[A-Z]{3,12}$/u),
+  nanos: safeNanosSchema,
+}).strict()
+const bucketSchema = totalSchema.extend({
+  kind: kindSchema,
+  calls: z.number().int().positive().max(Number.MAX_SAFE_INTEGER),
+}).strict()
+const coverageSchema = z.object({
+  accountedTurns: z.number().int().nonnegative().max(Number.MAX_SAFE_INTEGER),
+  unaccountedTurns: z.number().int().nonnegative().max(Number.MAX_SAFE_INTEGER),
+}).strict()
+
+function canonicalSummary(value: Pick<ModelCostProjection, 'totals' | 'breakdown'>): boolean {
+  for (let index = 1; index < value.totals.length; index++) {
+    const previous = value.totals[index - 1]
+    const current = value.totals[index]
+    if (previous === undefined || current === undefined
+      || previous.currency.localeCompare(current.currency) >= 0) return false
+  }
+  for (let index = 1; index < value.breakdown.length; index++) {
+    const previous = value.breakdown[index - 1]
+    const current = value.breakdown[index]
+    if (previous === undefined || current === undefined || compareBuckets(previous, current) >= 0) return false
+  }
+  const sums = new Map<string, number>()
+  for (const bucket of value.breakdown) {
+    const sum = safeAdd(sums.get(bucket.currency) ?? 0, bucket.nanos)
+    if (sum === undefined) return false
+    sums.set(bucket.currency, sum)
+  }
+  return sums.size === value.totals.length
+    && value.totals.every(total => sums.get(total.currency) === total.nanos)
+}
+
+const projectionSchema: z.ZodType<ModelCostProjection> = z.object({
+  totals: z.array(totalSchema),
+  breakdown: z.array(bucketSchema),
+  coverage: coverageSchema,
+}).strict().refine(canonicalSummary)
+const stateSchema: z.ZodType<ModelCostState> = z.object({
+  totals: z.array(totalSchema),
+  breakdown: z.array(bucketSchema),
+  coverage: coverageSchema,
+  fold: foldSchema.nullable(),
+}).strict().refine(canonicalSummary)
+
+declare module '@deepseek-ai/dsh-session-projection/types' {
+  interface SessionProjectionStateMap {
+    modelCost: ModelCostState
+  }
+}
+
+/** Cumulative monetary accounting for complete normal Turns in one Session log. */
+export const modelCostProjectionDefinition = {
+  key: 'modelCost',
+  stateVersion: 2,
+  stateSchema,
+  init: (): ModelCostState => ({
+    totals: [], breakdown: [], coverage: { accountedTurns: 0, unaccountedTurns: 0 }, fold: null,
+  }),
+  apply: (state, event) => {
+    const advanced = advanceModelCostTurn(state.fold ?? undefined, event)
+    if (advanced.closed === undefined) {
+      const fold = advanced.fold ?? null
+      return fold === state.fold ? state : { ...state, fold }
+    }
+    if (!advanced.closed.hadSettlement) return { ...state, fold: null }
+    const coverage = advanced.completed === undefined
+      ? {
+        ...state.coverage,
+        unaccountedTurns: requiredAdd(state.coverage.unaccountedTurns, 1),
+      }
+      : {
+        ...state.coverage,
+        accountedTurns: requiredAdd(state.coverage.accountedTurns, 1),
+      }
+    if (advanced.completed === undefined) return { ...state, coverage, fold: null }
+    const cumulative = addSummary(state.totals, state.breakdown, advanced.completed)
+    return { ...cumulative, coverage, fold: null }
+  },
+  wire: {
+    viewSchema: projectionSchema,
+    view: ({ totals, breakdown, coverage }) => ({ totals, breakdown, coverage }),
+  },
+} satisfies ProjectionDefinition<'modelCost', ModelCostState>
+
+function addSummary(
+  currentTotals: readonly ModelCostTotal[],
+  currentBreakdown: readonly ModelCostBucket[],
+  turn: TurnModelCost,
+): Pick<ModelCostState, 'totals' | 'breakdown'> {
+  const totals = new Map(currentTotals.map(item => [item.currency, item.nanos]))
+  for (const item of turn.totals) totals.set(item.currency, requiredAdd(totals.get(item.currency) ?? 0, item.nanos))
+
+  const breakdown = new Map(currentBreakdown.map(item => [`${item.currency}\0${item.kind}`, item]))
+  for (const item of turn.breakdown) {
+    const key = `${item.currency}\0${item.kind}`
+    const previous = breakdown.get(key)
+    breakdown.set(key, {
+      kind: item.kind,
+      currency: item.currency,
+      nanos: requiredAdd(previous?.nanos ?? 0, item.nanos),
+      calls: requiredAdd(previous?.calls ?? 0, item.calls),
+    })
+  }
+  return {
+    totals: [...totals].sort(([left], [right]) => left.localeCompare(right))
+      .map(([currency, nanos]) => ({ currency, nanos })),
+    breakdown: [...breakdown.values()].sort(compareBuckets),
+  }
+}
+
+function compareBuckets(left: ModelCostBucket, right: ModelCostBucket): number {
+  const order: Record<ModelCostKind, number> = { reported: 0, estimated: 1, virtual: 2 }
+  return left.currency.localeCompare(right.currency) || order[left.kind] - order[right.kind]
+}
+
+function safeAdd(left: number, right: number): number | undefined {
+  const result = left + right
+  return Number.isSafeInteger(result) && result >= 0 ? result : undefined
+}
+
+function requiredAdd(left: number, right: number): number {
+  const result = safeAdd(left, right)
+  if (result === undefined) throw new Error('modelCost projection exceeds safe integer accounting')
+  return result
+}
