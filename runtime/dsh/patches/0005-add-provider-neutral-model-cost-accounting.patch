diff --git a/packages/llm/token-meter/src/turn-cost.ts b/packages/llm/token-meter/src/turn-cost.ts
new file mode 100644
index 0000000..7ef66d8
--- /dev/null
+++ b/packages/llm/token-meter/src/turn-cost.ts
@@ -0,0 +1,288 @@
+import { validateModelCallAccounting } from '@deepseek-ai/dsh-llm'
+import type { ModelCallAccounting, ModelCallCost, ModelCostBreakdown, ModelCostKind } from '@deepseek-ai/dsh-llm'
+import type { SessionEvent } from '@deepseek-ai/dsh-session/types'
+import type { TurnTokenUsageRoute } from './turn-usage.ts'
+
+/** One per-currency monetary total suitable for compact presentation. */
+export interface ModelCostTotal {
+  readonly currency: string
+  readonly nanos: number
+}
+
+/** One cost-kind/currency aggregate retaining how many model calls contributed. */
+export interface ModelCostBucket extends ModelCostTotal {
+  readonly kind: ModelCostKind
+  readonly calls: number
+}
+
+/** One provenance-preserving Turn aggregate. */
+export interface TurnModelCostDetail extends ModelCostBucket {
+  readonly source: string
+  readonly tariffVersion?: string
+  readonly route?: TurnTokenUsageRoute
+  readonly breakdown?: ModelCostBreakdown
+}
+
+/** Exact additive monetary accounting for one completed normal Turn. */
+export interface TurnModelCost {
+  readonly totals: readonly ModelCostTotal[]
+  readonly breakdown: readonly ModelCostBucket[]
+  readonly details: readonly TurnModelCostDetail[]
+}
+
+/** One validated settled model call retained while a Turn remains open. */
+export interface ModelCostCall {
+  readonly accounting: ModelCallAccounting
+  readonly route?: TurnTokenUsageRoute
+}
+
+/** Replayable normal-Turn lifecycle state used by the helper and Session projection. */
+export interface ModelCostTurnFold {
+  readonly turn: number
+  readonly phase: 'idle' | 'open' | 'finishClosed' | 'settled'
+  readonly step?: number
+  readonly settledBy?: 'message' | 'retry'
+  readonly route?: TurnTokenUsageRoute
+  readonly calls: readonly ModelCostCall[]
+  readonly hadSettlement: boolean
+  readonly invalid: boolean
+}
+
+/** Result of advancing or closing one replayable normal-Turn cost fold. */
+export interface ModelCostTurnAdvance {
+  readonly fold?: ModelCostTurnFold
+  readonly completed?: TurnModelCost
+  readonly closed?: { readonly hadSettlement: boolean }
+}
+
+const KIND_ORDER: Record<ModelCostKind, number> = { reported: 0, estimated: 1, virtual: 2 }
+
+/**
+ * Fold one event through the strict normal-Turn accounting lifecycle.
+ * @param current - open Turn fold, or undefined outside a Turn.
+ * @param event - next durable Session event.
+ * @returns the advanced fold or a closed Turn summary and coverage fact.
+ */
+export function advanceModelCostTurn(
+  current: ModelCostTurnFold | undefined,
+  event: SessionEvent,
+): ModelCostTurnAdvance {
+  if (event.type === 'turn/start') {
+    if (current !== undefined) return { fold: { ...current, invalid: true } }
+    return { fold: {
+      turn: event.data.turn, phase: 'idle', calls: [], hadSettlement: false, invalid: false,
+    } }
+  }
+  if (current === undefined) return {}
+  if (event.type === 'turn/end') {
+    const valid = !current.invalid && current.turn === event.data.turn && current.phase === 'idle'
+    const completed = valid ? summarizeCalls(current.calls) : undefined
+    return {
+      closed: { hadSettlement: current.hadSettlement },
+      ...(completed === undefined ? {} : { completed }),
+    }
+  }
+  if (current.invalid) return { fold: current }
+  if (event.type === 'step/start') {
+    return event.data.turn === current.turn && current.phase === 'idle'
+      ? { fold: { ...current, phase: 'open', step: event.data.step } }
+      : { fold: { ...current, invalid: true } }
+  }
+  if (event.type === 'request/header') {
+    if (current.phase !== 'open') return { fold: current }
+    const { provider, model } = event.data.header.config
+    return { fold: { ...current, route: { provider, model } } }
+  }
+  if (event.type === 'assistant/message' || event.type === 'assistant/attempt') {
+    if (current.phase !== 'open' || event.data.turn !== current.turn || event.data.step !== current.step) {
+      return { fold: { ...current, invalid: true } }
+    }
+    const accounting = settlementAccounting(event)
+    if (accounting === undefined) {
+      return { fold: { ...current, hadSettlement: true, invalid: true } }
+    }
+    const messageRoute = event.type === 'assistant/message'
+      ? routeOf(event.data.message.source.provider, event.data.message.source.model)
+      : undefined
+    const route = messageRoute ?? current.route
+    const call: ModelCostCall = { accounting, ...(route === undefined ? {} : { route }) }
+    return { fold: {
+      ...current,
+      phase: event.type === 'assistant/message' ? 'settled' : 'finishClosed',
+      ...(event.type === 'assistant/message' ? { settledBy: 'message' as const } : {}),
+      calls: [...current.calls, call],
+      hadSettlement: true,
+    } }
+  }
+  if (event.type === 'llm/retry') {
+    const settled = current.phase === 'finishClosed'
+      || (current.phase === 'settled' && current.settledBy === 'message')
+    return event.data.turn === current.turn && event.data.step === current.step && settled
+      ? { fold: { ...current, phase: 'settled', settledBy: 'retry' } }
+      : { fold: { ...current, invalid: true } }
+  }
+  if (event.type === 'llm/retry-started') {
+    if (event.data.turn !== current.turn || event.data.step !== current.step
+      || current.phase !== 'settled' || current.settledBy !== 'retry') {
+      return { fold: { ...current, invalid: true } }
+    }
+    const { settledBy: _settledBy, ...withoutSettlement } = current
+    return { fold: { ...withoutSettlement, phase: 'open' } }
+  }
+  if (event.type === 'step/end') {
+    const settled = current.phase === 'finishClosed' || current.phase === 'settled'
+    return event.data.turn === current.turn && event.data.step === current.step && settled
+      ? { fold: {
+        turn: current.turn,
+        phase: 'idle',
+        calls: current.calls,
+        hadSettlement: current.hadSettlement,
+        invalid: false,
+      } }
+      : { fold: { ...current, invalid: true } }
+  }
+  return { fold: current }
+}
+
+/**
+ * Derive strict monetary accounting from one complete normal Turn event slice.
+ * @param events - durable events from one `turn/start` through its `turn/end`.
+ * @returns the complete accounted Turn, or undefined for incomplete or unaccounted input.
+ */
+export function deriveTurnCost(events: readonly SessionEvent[]): TurnModelCost | undefined {
+  let fold: ModelCostTurnFold | undefined
+  let completed: TurnModelCost | undefined
+  let sawEnd = false
+  for (const event of events) {
+    if (sawEnd) return undefined
+    const next = advanceModelCostTurn(fold, event)
+    fold = next.fold
+    if (event.type === 'turn/end') {
+      sawEnd = true
+      completed = next.completed
+    }
+  }
+  return sawEnd && fold === undefined ? completed : undefined
+}
+
+function settlementAccounting(
+  event: SessionEvent<'assistant/message'> | SessionEvent<'assistant/attempt'>,
+): ModelCallAccounting | undefined {
+  let stream: ModelCallAccounting | undefined
+  let finished = false
+  for (const record of event.data.stream) {
+    if (record.type !== 'chunk') continue
+    if (record.chunk.type === 'accounting') {
+      if (stream !== undefined || finished) return undefined
+      stream = record.chunk.accounting
+    }
+    if (record.chunk.type === 'finish') finished = true
+  }
+  const direct = event.data.accounting
+  try {
+    if (stream !== undefined) validateModelCallAccounting(stream)
+    if (direct !== undefined) validateModelCallAccounting(direct)
+  } catch {
+    return undefined
+  }
+  if (stream !== undefined && direct !== undefined && !accountingEquals(stream, direct)) return undefined
+  return direct ?? stream
+}
+
+function accountingEquals(left: ModelCallAccounting, right: ModelCallAccounting): boolean {
+  return left.costs.length === right.costs.length
+    && left.costs.every((cost, index) => costEquals(cost, right.costs[index]))
+}
+
+function costEquals(left: ModelCallCost, right: ModelCallCost | undefined): boolean {
+  if (right === undefined || left.kind !== right.kind || left.amount.currency !== right.amount.currency
+    || left.amount.nanos !== right.amount.nanos || left.source !== right.source
+    || left.tariffVersion !== right.tariffVersion) return false
+  const a = left.breakdown
+  const b = right.breakdown
+  return a === undefined || b === undefined ? a === b
+    : a.inputNanos === b.inputNanos && a.outputNanos === b.outputNanos
+      && a.cacheReadNanos === b.cacheReadNanos && a.cacheWriteNanos === b.cacheWriteNanos
+}
+
+function summarizeCalls(calls: readonly ModelCostCall[]): TurnModelCost | undefined {
+  if (calls.length === 0) return undefined
+  const totals = new Map<string, number>()
+  const buckets = new Map<string, ModelCostBucket>()
+  const details = new Map<string, TurnModelCostDetail>()
+  for (const call of calls) {
+    if (call.accounting.costs.length === 0) return undefined
+    for (const cost of call.accounting.costs) {
+      const { currency, nanos } = cost.amount
+      const total = safeAdd(totals.get(currency) ?? 0, nanos)
+      if (total === undefined) return undefined
+      totals.set(currency, total)
+
+      const bucketKey = `${currency}\0${cost.kind}`
+      const priorBucket = buckets.get(bucketKey)
+      const bucketNanos = safeAdd(priorBucket?.nanos ?? 0, nanos)
+      const bucketCalls = safeAdd(priorBucket?.calls ?? 0, 1)
+      if (bucketNanos === undefined || bucketCalls === undefined) return undefined
+      buckets.set(bucketKey, { kind: cost.kind, currency, nanos: bucketNanos, calls: bucketCalls })
+
+      const routeKey = call.route === undefined ? '' : `${call.route.provider}\0${call.route.model}`
+      const detailKey = `${bucketKey}\0${cost.source}\0${cost.tariffVersion ?? ''}\0${routeKey}`
+      const priorDetail = details.get(detailKey)
+      const detailNanos = safeAdd(priorDetail?.nanos ?? 0, nanos)
+      const detailCalls = safeAdd(priorDetail?.calls ?? 0, 1)
+      if (detailNanos === undefined || detailCalls === undefined) return undefined
+      let detailBreakdown: ModelCostBreakdown | undefined
+      if (priorDetail === undefined) {
+        detailBreakdown = cost.breakdown
+      } else if (priorDetail.breakdown !== undefined && cost.breakdown !== undefined) {
+        const next: ModelCostBreakdown = {}
+        for (const key of ['inputNanos', 'outputNanos', 'cacheReadNanos', 'cacheWriteNanos'] as const) {
+          const left = priorDetail.breakdown[key]
+          const right = cost.breakdown[key]
+          if (left === undefined || right === undefined) continue
+          const sum = safeAdd(left, right)
+          if (sum === undefined) return undefined
+          ;(next as Record<typeof key, number>)[key] = sum
+        }
+        detailBreakdown = Object.keys(next).length === 0 ? undefined : next
+      }
+      details.set(detailKey, {
+        kind: cost.kind,
+        currency,
+        nanos: detailNanos,
+        calls: detailCalls,
+        source: cost.source,
+        ...cost.tariffVersion === undefined ? {} : { tariffVersion: cost.tariffVersion },
+        ...call.route === undefined ? {} : { route: call.route },
+        ...detailBreakdown === undefined ? {} : { breakdown: detailBreakdown },
+      })
+    }
+  }
+  return {
+    totals: [...totals].sort(([left], [right]) => left.localeCompare(right))
+      .map(([currency, nanos]) => ({ currency, nanos })),
+    breakdown: [...buckets.values()].sort(compareBuckets),
+    details: [...details.values()].sort(compareDetails),
+  }
+}
+
+function compareBuckets(left: ModelCostBucket, right: ModelCostBucket): number {
+  return left.currency.localeCompare(right.currency) || KIND_ORDER[left.kind] - KIND_ORDER[right.kind]
+}
+
+function compareDetails(left: TurnModelCostDetail, right: TurnModelCostDetail): number {
+  return compareBuckets(left, right)
+    || left.source.localeCompare(right.source)
+    || (left.tariffVersion ?? '').localeCompare(right.tariffVersion ?? '')
+    || (left.route?.provider ?? '').localeCompare(right.route?.provider ?? '')
+    || (left.route?.model ?? '').localeCompare(right.route?.model ?? '')
+}
+
+function routeOf(provider: string, model: string): TurnTokenUsageRoute | undefined {
+  return provider.length > 0 && model.length > 0 ? { provider, model } : undefined
+}
+
+function safeAdd(left: number, right: number): number | undefined {
+  const result = left + right
+  return Number.isSafeInteger(result) && result >= 0 ? result : undefined
+}
