index 0000000..0fccf14
--- /dev/null
+++ b/packages/llm/llm/src/accounting.ts
@@ -0,0 +1,117 @@
+/** Runtime validation for provider-neutral model-call monetary accounting. */
+
+import type { ModelCallAccounting, ModelCallCost, ModelCostBreakdown, MonetaryAmount } from './types.ts'
+
+const COST_KINDS = new Set(['reported', 'estimated', 'virtual'])
+const BREAKDOWN_KEYS = ['inputNanos', 'outputNanos', 'cacheReadNanos', 'cacheWriteNanos'] as const
+
+/**
+ * Assert one model-call accounting payload at a provider or durable stream boundary.
+ * @param value - candidate accounting value.
+ * @returns after the value satisfies the complete accounting contract.
+ */
+export function validateModelCallAccounting(value: unknown): asserts value is ModelCallAccounting {
+  const accounting = record(value, 'model-call accounting')
+  exactKeys(accounting, ['costs'], 'model-call accounting')
+  if (!Array.isArray(accounting.costs) || accounting.costs.length === 0) {
+    throw new TypeError('Model-call accounting costs must be a non-empty array')
+  }
+  const seen = new Set<string>()
+  for (const [index, candidate] of accounting.costs.entries()) {
+    const cost = validateCost(candidate, index)
+    const key = `${cost.kind}\0${cost.amount.currency}`
+    if (seen.has(key)) {
+      throw new TypeError(`Model-call accounting repeats ${cost.kind} ${cost.amount.currency}`)
+    }
+    seen.add(key)
+  }
+}
+
+function validateCost(value: unknown, index: number): ModelCallCost {
+  const label = `model-call accounting cost ${String(index)}`
+  const cost = record(value, label)
+  exactKeys(cost, [
+    'kind', 'amount', 'source',
+    ...Object.hasOwn(cost, 'tariffVersion') ? ['tariffVersion'] : [],
+    ...Object.hasOwn(cost, 'breakdown') ? ['breakdown'] : [],
+  ], label)
+  if (typeof cost.kind !== 'string' || !COST_KINDS.has(cost.kind)) {
+    throw new TypeError(`${label} kind must be reported, estimated, or virtual`)
+  }
+  if (typeof cost.source !== 'string' || cost.source.length === 0) {
+    throw new TypeError(`${label} source must be a non-empty string`)
+  }
+  if (cost.tariffVersion !== undefined
+    && (typeof cost.tariffVersion !== 'string' || cost.tariffVersion.length === 0)) {
+    throw new TypeError(`${label} tariffVersion must be a non-empty string`)
+  }
+  const amount = validateAmount(cost.amount, `${label} amount`)
+  let breakdown: ModelCostBreakdown | undefined
+  if (cost.breakdown !== undefined) {
+    breakdown = validateBreakdown(cost.breakdown, label)
+    let classified = 0
+    for (const key of BREAKDOWN_KEYS) {
+      const value = breakdown[key]
+      if (value === undefined) continue
+      classified += value
+      if (!Number.isSafeInteger(classified) || classified > amount.nanos) {
+        throw new TypeError(`${label} breakdown exceeds its amount`)
+      }
+    }
+  }
+  return {
+    kind: cost.kind as ModelCallCost['kind'],
+    amount,
+    source: cost.source,
+    ...cost.tariffVersion === undefined ? {} : { tariffVersion: cost.tariffVersion },
+    ...breakdown === undefined ? {} : { breakdown },
+  }
+}
+
+function validateAmount(value: unknown, label: string): MonetaryAmount {
+  const amount = record(value, label)
+  exactKeys(amount, ['currency', 'nanos'], label)
+  if (typeof amount.currency !== 'string' || !/^[A-Z]{3,12}$/u.test(amount.currency)) {
+    throw new TypeError(`${label} currency must use 3-12 uppercase ASCII letters`)
+  }
+  safeNanos(amount.nanos, `${label} nanos`)
+  return { currency: amount.currency, nanos: amount.nanos as number }
+}
+
+function validateBreakdown(value: unknown, label: string): ModelCostBreakdown {
+  const breakdown = record(value, `${label} breakdown`)
+  const keys = Object.keys(breakdown)
+  if (keys.length === 0 || keys.some(key => !BREAKDOWN_KEYS.includes(key as typeof BREAKDOWN_KEYS[number]))) {
+    throw new TypeError(`${label} breakdown must contain only monetary bucket nanos`)
+  }
+  for (const key of BREAKDOWN_KEYS) {
+    if (breakdown[key] !== undefined) safeNanos(breakdown[key], `${label} breakdown ${key}`)
+  }
+  return {
+    ...breakdown.inputNanos === undefined ? {} : { inputNanos: breakdown.inputNanos as number },
+    ...breakdown.outputNanos === undefined ? {} : { outputNanos: breakdown.outputNanos as number },
+    ...breakdown.cacheReadNanos === undefined ? {} : { cacheReadNanos: breakdown.cacheReadNanos as number },
+    ...breakdown.cacheWriteNanos === undefined ? {} : { cacheWriteNanos: breakdown.cacheWriteNanos as number },
+  }
+}
+
+function safeNanos(value: unknown, label: string): void {
+  if (!Number.isSafeInteger(value) || Number(value) < 0 || Object.is(value, -0)) {
+    throw new TypeError(`${label} must be a non-negative safe integer`)
+  }
+}
+
+function record(value: unknown, label: string): Record<string, unknown> {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+    throw new TypeError(`${label} must be an object`)
+  }
+  return value as Record<string, unknown>
+}
+
+function exactKeys(value: Record<string, unknown>, expected: readonly string[], label: string): void {
+  const keys = Object.keys(value).sort()
+  const wanted = [...expected].sort()
+  if (keys.length !== wanted.length || keys.some((key, index) => key !== wanted[index])) {
+    throw new TypeError(`${label} fields must be exactly ${wanted.join(', ')}`)
+  }
+}
