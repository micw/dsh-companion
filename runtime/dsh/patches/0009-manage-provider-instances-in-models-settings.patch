+// @vitest-environment jsdom
+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { ProviderInstancesSection } from '../src/client/ProviderInstancesSection.tsx'
+import { en } from '../src/client/locales.ts'
+import { settingsSchema } from './settings-schema.client.ts'
+import type { ModelsSettingsState } from '../src/client/store.ts'
+
+const family = {
+  id: 'openrouter' as never,
+  displayName: 'OpenRouter',
+  maxInstances: null,
+  settingsNs: 'dsh-companion-openrouter',
+  instancesPath: ['instances'],
+}
+
+function state(overrides: Partial<ModelsSettingsState> = {}): ModelsSettingsState {
+  return {
+    status: 'ready',
+    error: null,
+    credentialError: null,
+    writable: true,
+    rows: [],
+    families: [family],
+    instances: [],
+    namespaces: new Map(),
+    ...overrides,
+  }
+}
+
+afterEach(cleanup)
+
+describe('provider instance settings', () => {
+  it('renders the empty state and saves a new family instance through the canonical operation', async () => {
+    const load = vi.fn(() => Promise.resolve())
+    const saveProviderInstance = vi.fn(() => Promise.resolve({
+      kind: 'saved' as const,
+      instance: {
+        id: 'instance-1' as never,
+        familyId: family.id,
+        provider: 'openrouter-instance-1',
+        displayName: 'Work',
+        enabled: true,
+        active: true,
+        settingsNs: family.settingsNs,
+        settingsPath: ['instances', 'instance-1'],
+        credential: 'configured' as const,
+      },
+    }))
+    render(<ProviderInstancesSection
+      state={state()}
+      controller={{ load } as never}
+      operations={{ saveProviderInstance } as never}
+      schema={settingsSchema}
+      t={key => en[key]}
+      renderProviderExtras={() => null}
+    />)
+
+    expect(screen.getByText(en.instancesEmpty)).toBeTruthy()
+    fireEvent.click(screen.getByText(en.add))
+    fireEvent.change(screen.getByLabelText(en.customDisplayName), { target: { value: 'Work' } })
+    fireEvent.change(screen.getByLabelText(en.keyInput), { target: { value: 'secret-key' } })
+    fireEvent.change(screen.getByLabelText(en.baseUrl), { target: { value: 'https://openrouter.example/api/v1' } })
+    fireEvent.click(screen.getByText(en.saveAndTest))
+
+    await waitFor(() => {
+      expect(saveProviderInstance).toHaveBeenCalledWith('openrouter', {
+        displayName: 'Work',
+        enabled: true,
+        config: { baseURL: 'https://openrouter.example/api/v1' },
+        credential: { kind: 'replace', value: 'secret-key' },
+      })
+    })
+    expect(load).toHaveBeenCalledTimes(1)
+  })
+
+  it('keeps a refused save open without exposing the submitted credential', async () => {
+    const saveProviderInstance = vi.fn(() => Promise.resolve({ kind: 'refused' as const, message: 'connection refused' }))
+    render(<ProviderInstancesSection
+      state={state()}
+      controller={{ load: vi.fn() } as never}
+      operations={{ saveProviderInstance } as never}
+      schema={settingsSchema}
+      t={key => en[key]}
+      renderProviderExtras={() => null}
+    />)
+
+    fireEvent.click(screen.getByText(en.add))
+    fireEvent.change(screen.getByLabelText(en.keyInput), { target: { value: 'never-render-this' } })
+    fireEvent.click(screen.getByText(en.saveAndTest))
+    expect(await screen.findByText('connection refused')).toBeTruthy()
+    expect(screen.queryByText('never-render-this')).toBeNull()
+    expect(screen.getByLabelText<HTMLInputElement>(en.keyInput).type).toBe('password')
+  })
+})
