+import { useState } from 'react'
+import type { ReactNode } from 'react'
+import type { LlmProviderFamily, LlmProviderInstance } from '@deepseek-ai/dsh-api-remotes/client'
+import { Button, IconPlusOutline16, Modal } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { ModelsOperations } from './operations.ts'
+import type { SettingsSchemaOperations } from './schema-operations.ts'
+import type { ModelsSettingsState, ModelsSettingsStore, ProviderDirectoryEntry } from './store.ts'
+import type { en } from './locales.ts'
+import styles from './ModelsSection.module.css'
+
+/** Props for the canonical provider-family and instance presentation. */
+export interface ProviderInstancesSectionProps {
+  state: ModelsSettingsState
+  controller: ModelsSettingsStore
+  operations: ModelsOperations
+  schema: SettingsSchemaOperations
+  t: (key: keyof typeof en) => string
+  renderProviderExtras: (
+    provider: ProviderDirectoryEntry,
+    configured: boolean,
+    keyConfigured: boolean,
+  ) => ReactNode
+}
+
+interface EditorDraft {
+  family: LlmProviderFamily
+  instance?: LlmProviderInstance
+  displayName: string
+  baseURL: string
+  apiKey: string
+  enabled: boolean
+}
+
+/** Render configured instances and the family-backed Add Provider dialog. */
+export function ProviderInstancesSection(props: ProviderInstancesSectionProps): ReactNode {
+  const { state, controller, operations, schema, t } = props
+  const [draft, setDraft] = useState<EditorDraft | undefined>(undefined)
+  const [failure, setFailure] = useState<string | undefined>(undefined)
+  const [busy, setBusy] = useState(false)
+  const [deleteTarget, setDeleteTarget] = useState<LlmProviderInstance | undefined>(undefined)
+  const families = state.families ?? []
+  const instances = state.instances ?? []
+
+  const countFor = (familyId: string): number => instances.filter(instance => instance.familyId === familyId).length
+  const addable = families.filter(family => family.maxInstances === null || countFor(family.id) < family.maxInstances)
+
+  const openCreate = (family: LlmProviderFamily): void => {
+    setFailure(undefined)
+    setDraft({ family, displayName: family.displayName, baseURL: '', apiKey: '', enabled: true })
+  }
+  const openEdit = (instance: LlmProviderInstance): void => {
+    const family = families.find(candidate => candidate.id === instance.familyId)
+    if (family === undefined) return
+    const namespace = state.namespaces.get(instance.settingsNs)
+    const profile = namespace === undefined ? undefined : schema.getPath(namespace.value, instance.settingsPath)
+    const baseURL = typeof profile === 'object' && profile !== null
+      && typeof (profile as { baseURL?: unknown }).baseURL === 'string'
+      ? (profile as { baseURL: string }).baseURL
+      : ''
+    setFailure(undefined)
+    setDraft({ family, instance, displayName: instance.displayName, baseURL, apiKey: '', enabled: instance.enabled })
+  }
+  const save = async (): Promise<void> => {
+    if (draft === undefined || operations.saveProviderInstance === undefined) return
+    setBusy(true)
+    setFailure(undefined)
+    try {
+      const result = await operations.saveProviderInstance(draft.family.id, {
+        ...draft.instance === undefined ? {} : { instanceId: draft.instance.id },
+        displayName: draft.displayName,
+        enabled: draft.enabled,
+        config: draft.baseURL.trim().length === 0 ? {} : { baseURL: draft.baseURL.trim() },
+        ...draft.apiKey.length === 0 ? {} : { credential: { kind: 'replace', value: draft.apiKey } },
+      })
+      if (result.kind === 'refused') { setFailure(result.message); return }
+      setDraft(undefined)
+      await controller.load()
+    } finally {
+      setBusy(false)
+    }
+  }
+  const remove = async (): Promise<void> => {
+    if (deleteTarget === undefined || operations.deleteProviderInstance === undefined) return
+    setBusy(true)
+    setFailure(undefined)
+    try {
+      const refused = await operations.deleteProviderInstance(deleteTarget.familyId, deleteTarget.id)
+      if (refused !== undefined) { setFailure(refused); return }
+      setDeleteTarget(undefined)
+      await controller.load()
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  return (
+    <div className={styles['section']}>
+      <h2 className={styles['title']}>{t('title')}</h2>
+      <p className={styles['intro']}>{t('instancesIntro')}</p>
+      {instances.length === 0 ? <p className={styles['notice']}>{t('instancesEmpty')}</p> : null}
+      <ul className={styles['rows']}>
+        {instances.map((instance) => {
+          const entry: ProviderDirectoryEntry = {
+            provider: instance.provider,
+            displayName: instance.displayName,
+            settingsNs: instance.settingsNs,
+            settingsPath: instance.settingsPath,
+            active: instance.active,
+            ...instance.error === undefined ? {} : { error: instance.error },
+          }
+          return (
+            <li key={`${instance.familyId}:${instance.id}`} className={styles['rowCard']}>
+              <div className={styles['rowHead']}>
+                <span className={styles['rowIdentity']}>
+                  <span className={styles['rowName']}>{instance.displayName}</span>
+                  <span className={styles['editorRoute']}>{instance.provider}</span>
+                  <span
+                    className={`${styles['credentialDot']} ${styles[instance.credential === 'configured'
+                      ? 'credentialDotConfigured'
+                      : 'credentialDotMissing']}`}
+                    role="img"
+                    aria-label={t(instance.credential === 'configured' ? 'credentialConfigured' : 'credentialMissing')}
+                  />
+                </span>
+                <span className={styles['rowActions']}>
+                  <button type="button" className={styles['secondaryButton']} onClick={() => { openEdit(instance) }}>
+                    {t('edit')}
+                  </button>
+                  <button
+                    type="button"
+                    className={styles['dangerButton']}
+                    disabled={!state.writable}
+                    onClick={() => { setFailure(undefined); setDeleteTarget(instance) }}
+                  >
+                    {t('remove')}
+                  </button>
+                </span>
+              </div>
+              {instance.error === undefined ? null : <p role="alert" className={styles['error']}>{instance.error}</p>}
+              {props.renderProviderExtras(entry, true, instance.credential === 'configured')}
+            </li>
+          )
+        })}
+      </ul>
+      <div className={styles['addBlock']}>
+        <button
+          type="button"
+          className={styles['addButton']}
+          disabled={!state.writable || addable.length === 0}
+          onClick={() => { const first = addable[0]; if (first !== undefined) openCreate(first) }}
+        >
+          <IconPlusOutline16 size={14} />
+          {t('add')}
+        </button>
+      </div>
+      <Modal
+        open={draft !== undefined}
+        onClose={() => { if (!busy) setDraft(undefined) }}
+        title={draft?.instance === undefined ? t('add') : t('edit')}
+        closeLabel={t('close')}
+        footer={(
+          <>
+            <Button variant="outline" disabled={busy} onClick={() => { setDraft(undefined) }}>{t('cancel')}</Button>
+            <Button disabled={busy || draft?.displayName.trim().length === 0} onClick={() => { void save() }}>
+              {t(busy ? 'testingProvider' : 'saveAndTest')}
+            </Button>
+          </>
+        )}
+      >
+        {draft === undefined ? null : (
+          <div className={styles['editor']}>
+            {draft.instance === undefined && families.length > 1 ? (
+              <label className={styles['field']}>
+                <span className={styles['fieldLabel']}>{t('provider')}</span>
+                <select
+                  className={`${styles['input']} ${styles['selectInput']}`}
+                  value={draft.family.id}
+                  onChange={(event) => {
+                    const family = addable.find(candidate => candidate.id === event.target.value)
+                    if (family !== undefined) openCreate(family)
+                  }}
+                >
+                  {addable.map(family => <option key={family.id} value={family.id}>{family.displayName}</option>)}
+                </select>
+              </label>
+            ) : null}
+            <label className={styles['field']}>
+              <span className={styles['fieldLabel']}>{t('customDisplayName')}</span>
+              <input className={styles['input']} value={draft.displayName} onChange={(event) => {
+                setDraft(current => current === undefined ? current : { ...current, displayName: event.target.value })
+              }} />
+            </label>
+            <label className={styles['field']}>
+              <span className={styles['fieldLabel']}>{t('keyInput')}</span>
+              <input type="password" autoComplete="off" className={styles['input']} value={draft.apiKey}
+                placeholder={draft.instance?.credential === 'configured' ? t('keyStored') : t('keyPlaceholder')}
+                onChange={(event) => {
+                  setDraft(current => current === undefined ? current : { ...current, apiKey: event.target.value })
+                }} />
+            </label>
+            <label className={styles['field']}>
+              <span className={styles['fieldLabel']}>{t('baseUrl')}</span>
+              <input className={styles['input']} value={draft.baseURL} placeholder={t('baseUrlDefault')}
+                onChange={(event) => {
+                  setDraft(current => current === undefined ? current : { ...current, baseURL: event.target.value })
+                }} />
+            </label>
+            <label className={styles['field']}>
+              <input type="checkbox" checked={draft.enabled} onChange={(event) => {
+                setDraft(current => current === undefined ? current : { ...current, enabled: event.target.checked })
+              }} />
+              <span className={styles['fieldLabel']}>{t('enabled')}</span>
+            </label>
+            {failure === undefined ? null : <p role="alert" className={styles['error']}>{failure}</p>}
+          </div>
+        )}
+      </Modal>
+      <Modal
+        open={deleteTarget !== undefined}
+        onClose={() => { if (!busy) setDeleteTarget(undefined) }}
+        title={deleteTarget === undefined ? '' : t('deleteInstanceTitle').replace('{provider}', deleteTarget.displayName)}
+        closeLabel={t('close')}
+        footer={(
+          <>
+            <Button variant="outline" disabled={busy} onClick={() => { setDeleteTarget(undefined) }}>{t('cancel')}</Button>
+            <Button variant="outline" disabled={busy} onClick={() => { void remove() }}>{t('remove')}</Button>
+          </>
+        )}
+      >
+        <p>{t('deleteInstanceDescription')}</p>
+        {failure === undefined ? null : <p role="alert" className={styles['error']}>{failure}</p>}
+      </Modal>
+    </div>
+  )
+}
