index 0000000000..e038276bea
--- /dev/null
+++ b/packages/llm/token-meter/tests/cost-projection.spec.ts
@@ -0,0 +1,164 @@
+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { createMessage, type ModelCallAccounting } from '@deepseek-ai/dsh-llm'
+import SessionStore, { type Session } from '@deepseek-ai/dsh-session'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import TokenMeter from '@deepseek-ai/dsh-token-meter'
+import type { ModelCostProjection } from '@deepseek-ai/dsh-token-meter/client'
+
+const ZERO: ModelCostProjection = {
+  totals: [], breakdown: [], coverage: { accountedTurns: 0, unaccountedTurns: 0 },
+}
+
+async function harness() {
+  const ctx = new Context()
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SessionProjectionRegistry)
+  const meterFiber = await ctx.plugin(TokenMeter)
+  return { ctx, session: ctx.sessions.create(), meterFiber }
+}
+
+function accounting(
+  kind: 'reported' | 'estimated' | 'virtual',
+  nanos: number,
+  scope: 'call' | 'turn' = 'call',
+): ModelCallAccounting {
+  return {
+    scope,
+    costs: [{ kind, amount: { currency: 'USD', nanos }, source: `${kind}-source` }],
+  }
+}
+
+function settleAttempt(session: Session, turn: number, step: number, value: ModelCallAccounting): void {
+  session.append('assistant/attempt', {
+    turn,
+    step,
+    accounting: value,
+    stream: [{ type: 'chunk', time: 0, chunk: {
+      type: 'usage', usage: { inputTokens: 0, outputTokens: 0 }, accounting: value,
+    } }],
+  })
+}
+
+function settleMessage(session: Session, turn: number, step: number, value?: ModelCallAccounting): void {
+  session.append('assistant/message', {
+    turn,
+    step,
+    message: createMessage({
+      role: 'assistant',
+      content: [],
+      source: { kind: 'model', provider: 'mock', model: 'mock' },
+    }),
+    stream: value === undefined ? [] : [
+      { type: 'chunk', time: 0, chunk: {
+        type: 'usage', usage: { inputTokens: 0, outputTokens: 0 }, accounting: value,
+      } },
+    ],
+    ...(value === undefined ? {} : { accounting: value }),
+  }, { surfaceOp: 'append' })
+}
+
+function projected(ctx: Context, session: Session): ModelCostProjection {
+  const value = ctx.sessionProjections.snapshot(session).values.modelCost
+  if (value === undefined) throw new Error('modelCost projection is not registered')
+  return value
+}
+
+describe('modelCost Session projection', () => {
+  it('commits complete Turn costs, includes retried attempts once, and replays after remount', async () => {
+    const { ctx, session, meterFiber } = await harness()
+    session.append('turn/start', { turn: 1 })
+    session.append('step/start', { turn: 1, step: 1 })
+    settleAttempt(session, 1, 1, accounting('reported', 4))
+    session.append('llm/retry', {
+      turn: 1,
+      step: 1,
+      retryId: 'retry-1',
+      attempt: 1,
+      delayMs: 0,
+      failure: { message: 'retry', code: 'SERVER' },
+    } as never)
+    session.append('llm/retry-started', { turn: 1, step: 1, retryId: 'retry-1', attempt: 1 } as never)
+    settleMessage(session, 1, 1, accounting('estimated', 6))
+    session.append('step/end', { turn: 1, step: 1 })
+    expect(projected(ctx, session)).toEqual(ZERO)
+    session.append('turn/end', { turn: 1, reason: { kind: 'completed' } })
+
+    const expected: ModelCostProjection = {
+      totals: [{ currency: 'USD', nanos: 10 }],
+      breakdown: [
+        { kind: 'reported', currency: 'USD', nanos: 4, calls: 1 },
+        { kind: 'estimated', currency: 'USD', nanos: 6, calls: 1 },
+      ],
+      coverage: { accountedTurns: 1, unaccountedTurns: 0 },
+    }
+    expect(projected(ctx, session)).toEqual(expected)
+    const checkpoint = JSON.parse(JSON.stringify(
+      ctx.sessionProjections.checkpoint(session),
+    )) as ReturnType<typeof ctx.sessionProjections.checkpoint>
+    expect(checkpoint.modelCost?.ver).toBe(3)
+    expect(ctx.sessionProjections.viewCheckpoint(checkpoint).modelCost).toEqual(expected)
+    const row = checkpoint.modelCost!
+    const duplicate = {
+      ...checkpoint,
+      modelCost: {
+        ...row,
+        val: {
+          ...(row.val as object),
+          totals: [{ currency: 'USD', nanos: 10 }, { currency: 'USD', nanos: 10 }],
+        },
+      },
+    }
+    expect(ctx.sessionProjections.viewCheckpoint(duplicate)).not.toHaveProperty('modelCost')
+
+    await meterFiber.dispose()
+    expect(ctx.sessionProjections.snapshot(session).values.modelCost).toBeUndefined()
+    await ctx.plugin(TokenMeter)
+    expect(projected(ctx, session)).toEqual(expected)
+    await ctx.fiber.dispose()
+  })
+
+  it('commits a final Turn snapshot over missing and prior call accounting', async () => {
+    const { ctx, session } = await harness()
+    session.append('turn/start', { turn: 1 })
+    session.append('step/start', { turn: 1, step: 1 })
+    settleMessage(session, 1, 1)
+    session.append('step/end', { turn: 1, step: 1 })
+    session.append('step/start', { turn: 1, step: 2 })
+    settleMessage(session, 1, 2, accounting('virtual', 2))
+    session.append('step/end', { turn: 1, step: 2 })
+    session.append('step/start', { turn: 1, step: 3 })
+    settleMessage(session, 1, 3, accounting('virtual', 10, 'turn'))
+    session.append('step/end', { turn: 1, step: 3 })
+    session.append('turn/end', { turn: 1, reason: { kind: 'completed' } })
+    expect(projected(ctx, session)).toEqual({
+      totals: [{ currency: 'USD', nanos: 10 }],
+      breakdown: [{ kind: 'virtual', currency: 'USD', nanos: 10, calls: 1 }],
+      coverage: { accountedTurns: 1, unaccountedTurns: 0 },
+    })
+    await ctx.fiber.dispose()
+  })
+
+  it('retains known totals while counting unaccounted model Turns', async () => {
+    const { ctx, session } = await harness()
+    session.append('turn/start', { turn: 1 })
+    session.append('step/start', { turn: 1, step: 1 })
+    settleMessage(session, 1, 1, accounting('virtual', 9))
+    session.append('step/end', { turn: 1, step: 1 })
+    expect(projected(ctx, session)).toEqual(ZERO)
+    session.append('turn/end', { turn: 1, reason: { kind: 'completed' } })
+    expect(projected(ctx, session).totals).toEqual([{ currency: 'USD', nanos: 9 }])
+
+    session.append('turn/start', { turn: 2 })
+    session.append('step/start', { turn: 2, step: 1 })
+    settleMessage(session, 2, 1)
+    session.append('step/end', { turn: 2, step: 1 })
+    session.append('turn/end', { turn: 2, reason: { kind: 'completed' } })
+    expect(projected(ctx, session)).toEqual({
+      totals: [{ currency: 'USD', nanos: 9 }],
+      breakdown: [{ kind: 'virtual', currency: 'USD', nanos: 9, calls: 1 }],
+      coverage: { accountedTurns: 1, unaccountedTurns: 1 },
+    })
+    await ctx.fiber.dispose()
+  })
+})
diff --git a/packages/llm/token-meter/tests/turn-cost.spec.ts b/packages/llm/token-meter/tests/turn-cost.spec.ts
