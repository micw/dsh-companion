@@ -0,0 +1,219 @@
+import { describe, expect, it } from 'vitest'
+import type { ModelCallAccounting } from '@deepseek-ai/dsh-llm'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import { deriveTurnCost } from '../src/turn-cost.ts'
+
+function event(seq: number, type: string, data: unknown): SessionEvent {
+  return { seq, time: seq, type, data } as unknown as SessionEvent
+}
+
+function accounting(
+  kind: 'reported' | 'estimated' | 'virtual',
+  currency: string,
+  nanos: number,
+  source: string,
+  tariffVersion?: string,
+  scope: 'call' | 'turn' = 'call',
+): ModelCallAccounting {
+  return {
+    scope,
+    costs: [{
+      kind,
+      amount: { currency, nanos },
+      source,
+      ...(tariffVersion === undefined ? {} : { tariffVersion }),
+    }] }
+}
+
+function accountingChunk(value: ModelCallAccounting, time: number) {
+  return {
+    type: 'chunk' as const,
+    time,
+    chunk: { type: 'usage' as const, usage: { inputTokens: 0, outputTokens: 0 }, accounting: value },
+  }
+}
+
+function attempt(seq: number, value?: ModelCallAccounting): SessionEvent {
+  return event(seq, 'assistant/attempt', {
+    turn: 1,
+    step: 1,
+    stream: value === undefined ? [] : [accountingChunk(value, seq)],
+    ...(value === undefined ? {} : { accounting: value }),
+  })
+}
+
+function message(seq: number, step: number, value?: ModelCallAccounting, provider = 'route', model = 'model'): SessionEvent {
+  return event(seq, 'assistant/message', {
+    turn: 1,
+    step,
+    stream: value === undefined ? [] : [accountingChunk(value, seq)],
+    message: {
+      id: `message-${String(seq)}`,
+      role: 'assistant',
+      content: [],
+      source: { kind: 'model', provider, model },
+    },
+    ...(value === undefined ? {} : { accounting: value }),
+  })
+}
+
+const start = (seq: number, step: number) => event(seq, 'step/start', { turn: 1, step })
+const end = (seq: number, step: number) => event(seq, 'step/end', { turn: 1, step })
+const header = (seq: number, provider: string, model: string) => event(seq, 'request/header', {
+  header: { config: { provider, model } }, reason: 'change',
+})
+
+function complete(...middle: readonly SessionEvent[]): SessionEvent[] {
+  return [
+    event(1, 'turn/start', { turn: 1 }),
+    ...middle,
+    event(99, 'turn/end', { turn: 1, reason: { kind: 'completed' } }),
+  ]
+}
+
+describe('deriveTurnCost', () => {
+  it('includes retries and Steps exactly once while retaining deterministic provenance detail', () => {
+    const first = accounting('reported', 'USD', 5, 'wire', 'v1')
+    const second = accounting('reported', 'USD', 7, 'wire', 'v1')
+    const third: ModelCallAccounting = { scope: 'call', costs: [
+      {
+        kind: 'virtual',
+        amount: { currency: 'USD', nanos: 20 },
+        source: 'subscription-list',
+        breakdown: { inputNanos: 12, outputNanos: 8 },
+      },
+      { kind: 'estimated', amount: { currency: 'EUR', nanos: 3 }, source: 'catalog', tariffVersion: '2026-09' },
+    ] }
+    expect(deriveTurnCost(complete(
+      start(2, 1),
+      header(3, 'fallback', 'first'),
+      attempt(4, first),
+      event(5, 'llm/retry', { turn: 1, step: 1 }),
+      event(6, 'llm/retry-started', { turn: 1, step: 1 }),
+      header(7, 'fallback', 'second'),
+      message(8, 1, second),
+      end(9, 1),
+      start(10, 2),
+      message(11, 2, third, 'subscription', 'model-b'),
+      end(12, 2),
+    ))).toEqual({
+      totals: [
+        { currency: 'EUR', nanos: 3 },
+        { currency: 'USD', nanos: 32 },
+      ],
+      breakdown: [
+        { kind: 'estimated', currency: 'EUR', nanos: 3, calls: 1 },
+        { kind: 'reported', currency: 'USD', nanos: 12, calls: 2 },
+        { kind: 'virtual', currency: 'USD', nanos: 20, calls: 1 },
+      ],
+      details: [
+        {
+          kind: 'estimated', currency: 'EUR', nanos: 3, calls: 1,
+          source: 'catalog', tariffVersion: '2026-09', route: { provider: 'subscription', model: 'model-b' },
+        },
+        {
+          kind: 'reported', currency: 'USD', nanos: 5, calls: 1,
+          source: 'wire', tariffVersion: 'v1', route: { provider: 'fallback', model: 'first' },
+        },
+        {
+          kind: 'reported', currency: 'USD', nanos: 7, calls: 1,
+          source: 'wire', tariffVersion: 'v1', route: { provider: 'route', model: 'model' },
+        },
+        {
+          kind: 'virtual', currency: 'USD', nanos: 20, calls: 1,
+          source: 'subscription-list', route: { provider: 'subscription', model: 'model-b' },
+          breakdown: { inputNanos: 12, outputNanos: 8 },
+        },
+      ],
+    })
+  })
+
+  it('lets one final Turn snapshot cover missing Tool attempts and replace prior call costs', () => {
+    const call = accounting('virtual', 'USD', 5, 'call', undefined, 'call')
+    const turn = accounting('virtual', 'USD', 30, 'turn-total', 'v1', 'turn')
+    expect(deriveTurnCost(complete(
+      start(2, 1), message(3, 1), end(4, 1),
+      start(5, 2), message(6, 2, call), end(7, 2),
+      start(8, 3), message(9, 3, turn), end(10, 3),
+    ))).toEqual({
+      totals: [{ currency: 'USD', nanos: 30 }],
+      breakdown: [{ kind: 'virtual', currency: 'USD', nanos: 30, calls: 1 }],
+      details: [{
+        kind: 'virtual', currency: 'USD', nanos: 30, calls: 1,
+        source: 'turn-total', tariffVersion: 'v1', route: { provider: 'route', model: 'model' },
+      }],
+    })
+  })
+
+  it('rejects accounting without the required scope', () => {
+    const invalid = {
+      costs: [{ kind: 'reported', amount: { currency: 'USD', nanos: 2 }, source: 'wire' }],
+    } as unknown as ModelCallAccounting
+    expect(deriveTurnCost(complete(
+      start(2, 1), message(3, 1, invalid), end(4, 1),
+    ))).toBeUndefined()
+  })
+
+  it('invalidates Turn snapshots followed by another settlement, retry, or Step', () => {
+    const turn = accounting('virtual', 'USD', 30, 'turn-total', undefined, 'turn')
+    expect(deriveTurnCost(complete(
+      start(2, 1), attempt(3, turn), end(4, 1),
+    ))).toBeUndefined()
+    expect(deriveTurnCost(complete(
+      start(2, 1), message(3, 1, turn),
+      event(4, 'llm/retry', { turn: 1, step: 1 }),
+      end(5, 1),
+    ))).toBeUndefined()
+    expect(deriveTurnCost(complete(
+      start(2, 1), message(3, 1, turn), end(4, 1),
+      start(5, 2), message(6, 2, turn), end(7, 2),
+    ))).toBeUndefined()
+  })
+
+  it('omits incomplete, missing, contradictory, malformed, and overflowing accounting', () => {
+    const value = accounting('reported', 'USD', 1, 'wire')
+    expect(deriveTurnCost(complete(start(2, 1), message(3, 1), end(4, 1)))).toBeUndefined()
+    expect(deriveTurnCost(complete(start(2, 1), message(3, 1, value)))).toBeUndefined()
+    expect(deriveTurnCost(complete(
+      start(2, 1),
+      event(3, 'assistant/message', {
+        ...message(3, 1, value).data,
+        accounting: accounting('reported', 'USD', 2, 'wire'),
+      }),
+      end(4, 1),
+    ))).toBeUndefined()
+    expect(deriveTurnCost(complete(
+      start(2, 1),
+      message(3, 1, accounting('reported', 'USD', -1, 'wire')),
+      end(4, 1),
+    ))).toBeUndefined()
+    expect(deriveTurnCost(complete(
+      start(2, 1),
+      event(3, 'assistant/attempt', {
+        turn: 1,
+        step: 1,
+        accounting: value,
+        stream: [accountingChunk(value, 3), accountingChunk(value, 4)],
+      }),
+      end(4, 1),
+    ))).toBeUndefined()
+    expect(deriveTurnCost(complete(
+      start(2, 1),
+      event(3, 'assistant/attempt', {
+        turn: 1,
+        step: 1,
+        accounting: value,
+        stream: [
+          { type: 'chunk', time: 3, chunk: { type: 'finish', reason: { kind: 'stop' } } },
+          accountingChunk(value, 4),
+        ],
+      }),
+      end(4, 1),
+    ))).toBeUndefined()
+    const maximum = accounting('reported', 'USD', Number.MAX_SAFE_INTEGER, 'wire')
+    expect(deriveTurnCost(complete(
+      start(2, 1), message(3, 1, maximum), end(4, 1),
+      start(5, 2), message(6, 2, value), end(7, 2),
+    ))).toBeUndefined()
+  })
+})
