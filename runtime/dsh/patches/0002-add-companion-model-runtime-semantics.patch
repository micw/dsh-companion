+/** Runtime validation for provider-neutral transient model status updates. */
+
+import type { ModelStatus, TimedModelStatus } from './types.ts'
+
+/**
+ * Assert one model status at a provider or durable stream boundary.
+ * @param value - candidate model status.
+ * @returns after the value satisfies its discriminated exact-field contract.
+ */
+export function validateModelStatus(value: unknown): asserts value is ModelStatus {
+  const status = record(value, 'model status')
+  if (status.kind !== 'reasoning-token-progress') {
+    throw new TypeError('Model status kind must be reasoning-token-progress')
+  }
+  exactKeys(status, ['kind', 'deltaTokens', 'basis'], 'reasoning-token-progress status')
+  if (!Number.isSafeInteger(status.deltaTokens) || Number(status.deltaTokens) < 0
+    || Object.is(status.deltaTokens, -0)) {
+    throw new TypeError('reasoning-token-progress deltaTokens must be a non-negative safe integer')
+  }
+  if (status.basis !== 'reported' && status.basis !== 'estimated') {
+    throw new TypeError('reasoning-token-progress basis must be reported or estimated')
+  }
+}
+
+/**
+ * Assert one ordered immutable-ready model-status timeline.
+ * @param value - candidate timeline, or undefined when no status was emitted.
+ * @returns after every row has exact fields, a safe time, and a valid status.
+ */
+export function validateTimedModelStatuses(value: unknown): asserts value is readonly TimedModelStatus[] | undefined {
+  if (value === undefined) return
+  if (!Array.isArray(value)) throw new TypeError('Model statuses must be an array')
+  let previousTime = -1
+  for (const [index, candidate] of value.entries()) {
+    const row = record(candidate, `Model status ${String(index)}`)
+    exactKeys(row, ['time', 'status'], `Model status ${String(index)}`)
+    if (!Number.isSafeInteger(row.time) || Number(row.time) < 0 || Object.is(row.time, -0)) {
+      throw new TypeError(`Model status ${String(index)} time must be a non-negative safe integer`)
+    }
+    if (Number(row.time) < previousTime) throw new TypeError('Model status times must be nondecreasing')
+    previousTime = Number(row.time)
+    validateModelStatus(row.status)
+  }
+}
+
+function record(value: unknown, label: string): Record<string, unknown> {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+    throw new TypeError(`${label} must be an object`)
+  }
+  return value as Record<string, unknown>
+}
+
+function exactKeys(value: Record<string, unknown>, expected: readonly string[], label: string): void {
+  const keys = Object.keys(value).sort()
+  const wanted = [...expected].sort()
+  if (keys.length !== wanted.length || keys.some((key, index) => key !== wanted[index])) {
+    throw new TypeError(`${label} fields must be exactly ${wanted.join(', ')}`)
+  }
+}
