diff --git a/packages/llm/llm/src/provider-family.ts b/packages/llm/llm/src/provider-family.ts
new file mode 100644
index 0000000000..29134cda6b
--- /dev/null
+++ b/packages/llm/llm/src/provider-family.ts
@@ -0,0 +1,218 @@
+/** Installed provider-family registration and serialized instance mutations. */
+import { randomUUID } from 'node:crypto'
+import { snapshotJsonValue } from '@deepseek-ai/dsh-util-values'
+import { LlmError } from './index.ts'
+import { LlmProviderInstanceId } from './brand.ts'
+import type {
+  LlmProviderFamily,
+  LlmProviderInstance,
+  LlmProviderInstanceDraft,
+} from './types.ts'
+
+/** Input supplied to one provider family's save-and-test implementation. */
+export interface LlmProviderInstanceSave {
+  readonly instanceId: LlmProviderInstanceId
+  readonly create: boolean
+  readonly draft: LlmProviderInstanceDraft
+}
+
+/** Family-owned persistence and connection operations. */
+export interface LlmProviderFamilyController {
+  listInstances(): readonly LlmProviderInstance[] | Promise<readonly LlmProviderInstance[]>
+  saveAndTest(save: LlmProviderInstanceSave, signal?: AbortSignal): Promise<LlmProviderInstance>
+  deleteInstance(instanceId: LlmProviderInstanceId, signal?: AbortSignal): Promise<void>
+}
+
+/** Live registration of one installed provider family. */
+export interface ProviderFamilyRegistrationHandle {
+  (): void
+  changed(): void
+}
+
+interface Registration {
+  readonly family: LlmProviderFamily
+  readonly controller: LlmProviderFamilyController
+}
+
+/** Runtime owner for provider-family metadata and mutations. */
+export class ProviderFamilyRuntime {
+  private readonly families = new Map<string, Registration>()
+  private readonly operations = new Map<string, Promise<void>>()
+
+  /** @param changed - publishes topology changes to clients. */
+  constructor(private readonly changed: () => void) {}
+
+  /** Register one installed family and its authoritative controller.
+   * @param family Installed family metadata.
+   * @param controller Family-owned persistence operations.
+   * @returns disposable registration and external-change notification operation.
+   */
+  register(family: LlmProviderFamily, controller: LlmProviderFamilyController): ProviderFamilyRegistrationHandle {
+    const detached = normalizeFamily(family)
+    if (this.families.has(detached.id)) {
+      throw new LlmError(`provider family "${detached.id}" is already registered`, 'DUPLICATE_PROVIDER_FAMILY')
+    }
+    let disposed = false
+    this.families.set(detached.id, { family: detached, controller })
+    this.changed()
+    const handle = (() => {
+      if (disposed) return
+      disposed = true
+      this.families.delete(detached.id)
+      this.changed()
+    }) as ProviderFamilyRegistrationHandle
+    handle.changed = () => {
+      if (disposed) throw new LlmError('this provider-family registration was disposed', 'REGISTRATION_DISPOSED')
+      this.changed()
+    }
+    return handle
+  }
+
+  /** List installed family metadata.
+   * @returns detached families in registration order.
+   */
+  listFamilies(): LlmProviderFamily[] {
+    return [...this.families.values()].map(({ family }) => ({
+      ...family,
+      instancesPath: [...family.instancesPath],
+    }))
+  }
+
+  /** List and validate configured instances in family order.
+   * @returns detached validated instance projections.
+   */
+  async listInstances(): Promise<LlmProviderInstance[]> {
+    const instances: LlmProviderInstance[] = []
+    const routes = new Set<string>()
+    for (const registration of this.families.values()) {
+      const ids = new Set<string>()
+      for (const instance of await registration.controller.listInstances()) {
+        const normalized = normalizeProviderInstance(registration.family, instance)
+        if (ids.has(normalized.id)) {
+          throw new LlmError(`provider family "${registration.family.id}" returned duplicate instance ids`, 'INVALID_PROVIDER_INSTANCE')
+        }
+        if (routes.has(normalized.provider)) {
+          throw new LlmError(`provider route "${normalized.provider}" is claimed by multiple instances`, 'INVALID_PROVIDER_INSTANCE')
+        }
+        ids.add(normalized.id)
+        routes.add(normalized.provider)
+        instances.push(normalized)
+      }
+      if (registration.family.maxInstances !== null && ids.size > registration.family.maxInstances) {
+        throw new LlmError(`provider family "${registration.family.id}" exceeds its instance limit`, 'PROVIDER_INSTANCE_LIMIT')
+      }
+    }
+    return instances
+  }
+
+  /** Create or update one instance through its family's atomic operation.
+   * @param familyId Installed family identity.
+   * @param draft Validated instance draft and credential action.
+   * @param signal Cancellation for family-owned I/O.
+   * @returns the committed redacted instance projection.
+   */
+  save(familyId: string, draft: LlmProviderInstanceDraft, signal: AbortSignal): Promise<LlmProviderInstance> {
+    return this.run(familyId, async (registration) => {
+      const normalizedDraft = normalizeProviderDraft(draft)
+      const existing = await registration.controller.listInstances()
+      const current = normalizedDraft.instanceId === undefined
+        ? undefined
+        : existing.find(instance => instance.id === normalizedDraft.instanceId)
+      if (normalizedDraft.instanceId !== undefined && current === undefined) {
+        throw new LlmError('the provider instance to update does not exist', 'NO_PROVIDER_INSTANCE')
+      }
+      const create = normalizedDraft.instanceId === undefined
+      if (create && registration.family.maxInstances !== null
+        && existing.length >= registration.family.maxInstances) {
+        throw new LlmError(`provider family "${familyId}" reached its instance limit`, 'PROVIDER_INSTANCE_LIMIT')
+      }
+      const instanceId = normalizedDraft.instanceId ?? LlmProviderInstanceId(randomUUID())
+      const saved = normalizeProviderInstance(registration.family, await registration.controller.saveAndTest({
+        instanceId,
+        create,
+        draft: normalizedDraft,
+      }, signal))
+      if (saved.id !== instanceId) {
+        throw new LlmError('provider family changed the instance identity during save', 'INVALID_PROVIDER_INSTANCE')
+      }
+      this.changed()
+      return saved
+    })
+  }
+
+  /** Delete one existing instance through its owning family.
+   * @param familyId Installed family identity.
+   * @param instanceId Existing instance identity.
+   * @param signal Cancellation for family-owned cleanup.
+   */
+  async delete(familyId: string, instanceId: string, signal: AbortSignal): Promise<void> {
+    await this.run(familyId, async (registration) => {
+      if (instanceId.length === 0) throw new LlmError('provider instance id must be non-empty', 'INVALID_PROVIDER_INSTANCE')
+      const branded = LlmProviderInstanceId(instanceId)
+      if (!(await registration.controller.listInstances()).some(instance => instance.id === branded)) {
+        throw new LlmError('the provider instance to delete does not exist', 'NO_PROVIDER_INSTANCE')
+      }
+      await registration.controller.deleteInstance(branded, signal)
+      this.changed()
+    })
+  }
+
+  private async run<T>(familyId: string, operation: (registration: Registration) => Promise<T>): Promise<T> {
+    const previous = this.operations.get(familyId) ?? Promise.resolve()
+    let release: () => void = () => undefined
+    const active = new Promise<void>((resolve) => { release = resolve })
+    const tail = previous.then(() => active)
+    this.operations.set(familyId, tail)
+    await previous
+    try {
+      const registration = this.families.get(familyId)
+      if (registration === undefined) throw new LlmError(`provider family "${familyId}" is not registered`, 'NO_PROVIDER_FAMILY')
+      return await operation(registration)
+    } finally {
+      release()
+      if (this.operations.get(familyId) === tail) this.operations.delete(familyId)
+    }
+  }
+}
+
+function normalizeFamily(family: LlmProviderFamily): LlmProviderFamily {
+  if (family.id.length === 0 || family.displayName.length === 0 || family.settingsNs.length === 0
+    || family.instancesPath.some(segment => segment.length === 0)
+    || (family.maxInstances !== null && (!Number.isSafeInteger(family.maxInstances) || family.maxInstances <= 0))) {
+    throw new LlmError('provider families need valid identities, settings paths, and instance limits', 'INVALID_PROVIDER_FAMILY')
+  }
+  return { ...family, instancesPath: [...family.instancesPath] }
+}
+
+function normalizeProviderInstance(family: LlmProviderFamily, instance: LlmProviderInstance): LlmProviderInstance {
+  if (instance.id.length === 0 || instance.familyId !== family.id || instance.provider.length === 0
+    || instance.displayName.length === 0 || instance.settingsNs !== family.settingsNs
+    || instance.settingsPath.some(segment => segment.length === 0)
+    || !['configured', 'missing', 'not-required'].includes(instance.credential)
+    || (instance.error !== undefined && instance.error.length === 0)) {
+    throw new LlmError(`provider family "${family.id}" returned an invalid instance`, 'INVALID_PROVIDER_INSTANCE')
+  }
+  return { ...instance, familyId: family.id, settingsNs: family.settingsNs, settingsPath: [...instance.settingsPath] }
+}
+
+function normalizeProviderDraft(draft: LlmProviderInstanceDraft): LlmProviderInstanceDraft {
+  if ((draft.instanceId !== undefined && draft.instanceId.length === 0) || draft.displayName.trim().length === 0) {
+    throw new LlmError('provider instance draft has invalid identity or display fields', 'INVALID_PROVIDER_INSTANCE')
+  }
+  const config = snapshotJsonValue(draft.config)
+  if (config === undefined || Array.isArray(config) || typeof config !== 'object' || config === null) {
+    throw new LlmError('provider instance config must be a lossless JSON object', 'INVALID_PROVIDER_INSTANCE')
+  }
+  if (draft.credential?.kind === 'replace' && draft.credential.value.length === 0) {
+    throw new LlmError('provider instance credential action is invalid', 'INVALID_PROVIDER_INSTANCE')
+  }
+  return {
+    ...draft.instanceId === undefined ? {} : { instanceId: draft.instanceId },
+    displayName: draft.displayName.trim(),
+    enabled: draft.enabled,
+    config,
+    ...draft.credential === undefined ? {} : draft.credential.kind === 'replace'
+      ? { credential: { kind: 'replace' as const, value: draft.credential.value } }
+      : { credential: { kind: draft.credential.kind } },
+  }
+}
