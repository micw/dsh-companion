+class MemoryFamilyController implements LlmProviderFamilyController {
+  readonly instances: LlmProviderInstance[] = []
+  readonly saves: LlmProviderInstanceSave[] = []
+  readonly deletes: string[] = []
+
+  listInstances(): readonly LlmProviderInstance[] {
+    return this.instances
+  }
+
+  saveAndTest(save: LlmProviderInstanceSave): Promise<LlmProviderInstance> {
+    this.saves.push(save)
+    const previous = this.instances.find(instance => instance.id === save.instanceId)
+    const next = projectedInstance(save.instanceId, {
+      provider: previous?.provider ?? `example/${save.instanceId}`,
+      displayName: save.draft.displayName,
+      enabled: save.draft.enabled,
+      active: save.draft.enabled,
+    })
+    if (previous === undefined) this.instances.push(next)
+    else this.instances.splice(this.instances.indexOf(previous), 1, next)
+    return Promise.resolve(next)
+  }
+
+  deleteInstance(instanceId: ReturnType<typeof LlmProviderInstanceId>): Promise<void> {
+    this.deletes.push(instanceId)
+    const index = this.instances.findIndex(instance => instance.id === instanceId)
+    if (index >= 0) this.instances.splice(index, 1)
+    return Promise.resolve()
+  }
+}
