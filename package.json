{
  "name": "dsh-companion-workspace",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm --filter './packages/**' run build && pnpm --filter dsh-companion-vscode compile",
    "watch": "pnpm --filter dsh-companion-vscode watch",
    "test": "pnpm run build && node --test tests/*.test.mjs packages/*/tests/*.test.mjs",
    "test:settings-native": "node scripts/smoke-settings-editor.mjs",
    "runtime:verify": "node runtime/dsh/scripts/verify.mjs",
    "runtime:prepare": "node runtime/dsh/scripts/prepare.mjs",
    "runtime:build:linux": "node runtime/dsh/scripts/build-linux.mjs",
    "version:resolve": "node scripts/version.mjs",
    "vscode:package": "node scripts/package-vscode.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
